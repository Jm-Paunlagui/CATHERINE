# =============================================================================
# CATHERINE Backend - environment template
# =============================================================================
# Copy to .env and fill in. Every value shown is either the code default or a
# safe development value; where they differ the comment says
# "code default X; recommended Y". Never commit a real .env.
#
# Secrets marked (required) are checked by src/config/bootGuard.js: each must be
# at least 32 characters and must not be one of the placeholders shipped here.
# In production a violation stops the boot; elsewhere it only logs a warning.
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================


# -----------------------------------------------------------------------------
# Demo mode
# -----------------------------------------------------------------------------
# true = run with ZERO database setup. Authentication, audit logs, admin
# management and changelog are served from in-memory fixtures and no Oracle
# pool is opened. Refused by the boot guard when NODE_ENV=production.
DEMO_MODE=false


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# PORT - code default 2108.
PORT=2108
# HOST - code default 0.0.0.0 (all interfaces).
HOST=0.0.0.0
NODE_ENV=production
# USE_HTTPS - true = serve TLS from the PFX described below.
USE_HTTPS=false
# APP_NAME - product name used in email subjects and bodies. Code default CATHERINE.
APP_NAME=CATHERINE
# FRONTEND_BASE_URL - absolute SPA origin used to build links in emails
# (e.g. https://app.example.com). Blank = emails carry no sign-in link.
FRONTEND_BASE_URL=

# TZ - the process time zone (a Node.js/libc runtime variable, not read by app
# code). Must be a REAL OS environment variable set BEFORE the process starts
# (system env / service config); it is NOT loaded from this file.
# TZ=UTC

# APP_TZ - process time zone pinned in server.js BEFORE the first Date is built.
# node-oracledb converts DATE/TIMESTAMP using the PROCESS zone, so keep it equal
# to the zone the schema stores wall-clock values in. A real OS env APP_TZ wins.
# IANA zone name. Code default Asia/Manila.
APP_TZ=Asia/Manila

# DB_TIMEZONE_OFFSET_MINUTES - the Oracle session's UTC offset in minutes
# (e.g. 0 = UTC, 480 = UTC+8, -300 = UTC-5). Load-bearing for row-signature
# (SYSSIGNATURE) verification: a signed row's timestamp must canonicalise to the
# same wall-clock the DB wrote. Keep aligned with the Oracle session time zone.
DB_TIMEZONE_OFFSET_MINUTES=480


# -----------------------------------------------------------------------------
# TLS certificate (only when USE_HTTPS=true)
# -----------------------------------------------------------------------------
# Place a PKCS#12 (.p12 / .pfx) certificate in certs/. For compiled (pkg)
# builds certs/ must sit next to the executable. The server refuses to start
# when USE_HTTPS=true and the file is missing.
# PFX_FILENAME   - file name inside certs/. Code default server.pfx.
# PFX_PASSPHRASE - passphrase for the PFX. Code default empty.
# PFX_FILENAME=server.pfx
# PFX_PASSPHRASE=


# -----------------------------------------------------------------------------
# Clustering
# -----------------------------------------------------------------------------
# ENABLE_CLUSTERING - true = fork NUM_WORKERS processes sharing the listen port.
#                     Code default false.
# NUM_WORKERS       - worker count. Code default = number of CPU cores.
#
# Per-worker resource math (read BEFORE raising NUM_WORKERS):
#   - Oracle pools are PER WORKER: total DB sessions ~= NUM_WORKERS x
#     (APP_POOL_MAX + APP_BULK_POOL_MAX). Keep that within the DB
#     PROCESSES/SESSIONS limit, e.g. 8 workers x (10 + 6) = 128 sessions.
#   - UV_THREADPOOL_SIZE is PER WORKER (about 1 MB stack per thread).
#   - Rate limits, security-filter IP blocks, scheduler state, the metrics
#     snapshot, alert acks and LOGIN_* lockout counters are SHARED across
#     workers through the primary, so RATE_LIMIT_MAX and LOGIN_MAX_ATTEMPTS are
#     cluster-wide. If the primary cannot answer in time a worker counts locally.
#   - Cache invalidations are synced across workers automatically.
#   - Scheduled jobs (alert poll, log retention, DB backup) run on ONE elected
#     cron-leader worker; the primary re-elects on leader death.
ENABLE_CLUSTERING=false
NUM_WORKERS=2

# CRON_LEADER - DO NOT SET. The primary stamps exactly one worker with
# CRON_LEADER=true at fork time and every other worker with false. Anything
# other than the exact string "true" is a follower (fails closed). When
# ENABLE_CLUSTERING=false the single process is always the leader. Setting it by
# hand risks zero or several leaders (duplicate job runs).

# SNOWFLAKE_MACHINE_ID - 0-1023, the machine id embedded in generated Snowflake
# ids. Set a distinct value per host in multi-host deployments. Unset = derived
# from a hash of the first non-internal IPv4 address (fallback: pid % 1024).
# SNOWFLAKE_MACHINE_ID=


# -----------------------------------------------------------------------------
# libuv thread pool
# -----------------------------------------------------------------------------
# node-oracledb (Thick mode) runs every DB call on a libuv worker thread; the
# Node.js default of 4 threads serialises concurrent Oracle work. server.js
# defaults this to 48. The pool is created on first async I/O, before dotenv
# loads, so an override only works as a REAL OS environment variable (system
# env / service config / $env:UV_THREADPOOL_SIZE before launch), NOT from here.
# UV_THREADPOOL_SIZE=48


# -----------------------------------------------------------------------------
# Session tokens and secrets
# -----------------------------------------------------------------------------
# JWT_SECRET (required) - signs access and refresh tokens.
JWT_SECRET=your-jwt-secret-here-change-in-production
# JWT_EXPIRES_IN - access token lifetime (also the access cookie lifetime).
# Format <n>s|m|h|d. Code default 30m. Ended sessions are remembered this long;
# any other format falls back to the refresh lifetime for that purpose.
JWT_EXPIRES_IN=30m
# JWT_REFRESH_EXPIRES_IN - refresh token lifetime. Format <n>s|m|h|d. Code default 7d.
JWT_REFRESH_EXPIRES_IN=7d

# CSRF_SECRET (required) - keys the double-submit CSRF token.
CSRF_SECRET=your-csrf-secret-key-here-change-in-production

# COOKIE_SECRET (required) - signs HTTP-only cookies.
COOKIE_SECRET=


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# CORS_ORIGINS - comma-separated explicit allow-list of browser origins.
# REQUIRED in production: the boot guard refuses to start without it (unless
# CORS_ALLOW_BROAD_PATTERNS=true). NODE_ENV=production disables every wildcard
# pattern, so this list is the ONLY thing that lets a browser reach the API.
# When the SPA is served from https://<SERVER>/ and the API from
# https://<SERVER>:<API_PORT>, those are different ORIGINS, so list the SPA's:
#   CORS_ORIGINS=https://<SERVER>
# Unset, the server boots and passes health checks while every request from the
# real frontend fails with an opaque browser-side CORS error.
CORS_ORIGINS=http://localhost:2108,http://localhost:5173

# CORS_ALLOW_BROAD_PATTERNS - code default false. In production the broad
# wildcard patterns (*.vpn, *.corp, *.internal, *.local, *.lan and the RFC 1918
# ranges) are disabled (CWE-942). true re-enables them; only for deployments
# where origin topology is trusted. NEVER true on an internet-facing deployment.
CORS_ALLOW_BROAD_PATTERNS=false


# -----------------------------------------------------------------------------
# Request handling: body size, rate limits, proxy, IP filter
# -----------------------------------------------------------------------------
# BODY_LIMIT - max JSON/urlencoded body (bytes or a unit string). Code default 10mb.
BODY_LIMIT=10mb

# Default rate limiter only. The auth limiters (login ceiling 30, login per
# user 5, refresh 20, change-password 5, all per 15 min) are fixed in
# src/constants/authRateLimits.js and have no env override.
# RATE_LIMIT_MAX - requests per window per IP. Code default 100.
RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS - window length in ms. Code default 900000 (15 min).
RATE_LIMIT_WINDOW_MS=900000

# TRUST_PROXY - decides what req.ip is; every rate limiter keys on it.
#   false (code default): req.ip is the TCP peer. Correct ONLY with no proxy in
#     front. Behind a reverse proxy, false makes every user share the proxy IP.
#   behind a reverse proxy / load balancer: set the HOP COUNT, e.g. 1.
#   never "true": it trusts the leftmost X-Forwarded-For entry, which the client
#     forges (CWE-290).
TRUST_PROXY=false

# ENABLE_IP_FILTER - true = only ALLOWED_IPS may connect. Code default false.
ENABLE_IP_FILTER=false
# ALLOWED_IPS - comma-separated IP allow-list used when ENABLE_IP_FILTER=true.
ALLOWED_IPS=

# SERVER_REQUEST_TIMEOUT_MS - Node HTTP server.requestTimeout, ms. Code default
# 330000. A reverse proxy in front needs an equal-or-larger timeout.
SERVER_REQUEST_TIMEOUT_MS=330000


# -----------------------------------------------------------------------------
# Database (Oracle)
# -----------------------------------------------------------------------------
# Skipped entirely when DEMO_MODE=true.
# DB_TYPE - adapter name. Only "oracle" ships. Code default oracle.
DB_TYPE=oracle
DB_HOST=localhost
DB_PORT=1521
# DB_APP_SERVICE_NAME - despite the name, this value is used as the Oracle SID:
# the connect string is built as (CONNECT_DATA=(SID=<value>)). A PDB service
# name (e.g. XEPDB1) is NOT a SID and will be refused by the listener unless the
# listener maps it. Typical SIDs: XE, ORCL. The key name is kept for
# compatibility with existing deployments.
DB_APP_SERVICE_NAME=XE

APP_DB_USERNAME=
APP_DB_PASSWORD=

# ORACLE_INSTANT_CLIENT - Instant Client directory; enables Thick mode.
# Blank = Thin mode.
ORACLE_INSTANT_CLIENT=C:\\oracle\\instantclient_23_8


# -----------------------------------------------------------------------------
# Oracle pool sizing (appDb - interactive traffic)
# -----------------------------------------------------------------------------
# Oracle holds a server process per poolMin connection even when idle, so do
# not over-provision poolMin. Size poolMax by CONNECTIONS PER PAGE LOAD, not by
# user count: every model call borrows its own connection.
#   APP_POOL_MIN     - connections opened at startup. Code default 5; recommended 2.
#                      0 is treated as unset (falls back to 5).
#   APP_POOL_MAX     - hard ceiling; requests queue past it. Code default 20;
#                      recommended 10.
#   APP_QUEUE_MAX    - acquire-queue depth; past it the request is shed
#                      (NJS-076 -> HTTP 429). Code default 40.
#   APP_POOL_TIMEOUT - SECONDS an idle connection above poolMin survives.
#                      0 = never close. Code default 30.
# Watch ORACLE_POOL_QUEUE_BACKLOG after changing these.
APP_POOL_MIN=2
APP_POOL_MAX=10
APP_QUEUE_MAX=40
APP_POOL_TIMEOUT=30


# -----------------------------------------------------------------------------
# Oracle pool sizing (appDbBulk - long-hold work)
# -----------------------------------------------------------------------------
# Second pool on the SAME credentials for exports, backup, purge and restore so
# long-held connections never starve interactive traffic. Values shown are the
# code defaults.
#   APP_BULK_POOL_MIN        - code default 1.
#   APP_BULK_POOL_MAX        - code default 6.
#   APP_BULK_QUEUE_MAX       - code default 24.
#   APP_BULK_QUEUE_TIMEOUT   - ms an acquire may wait in the queue (NJS-040).
#                              Code default 30000.
#   APP_BULK_CONNECT_TIMEOUT - ms for the acquire race; the driver receives
#                              ceil(ms/1000) s (Thin mode only). Code default 20000.
APP_BULK_POOL_MIN=1
APP_BULK_POOL_MAX=6
APP_BULK_QUEUE_MAX=24
APP_BULK_QUEUE_TIMEOUT=30000
APP_BULK_CONNECT_TIMEOUT=20000


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# LOG_LEVEL - least severe RFC 5424 level written, case-insensitive: EMERGENCY |
# ALERT | CRITICAL | ERROR | WARNING (alias WARN) | NOTICE | INFO | DEBUG.
# Code default INFO.
LOG_LEVEL=INFO
# ENABLE_CONSOLE_LOGS - false always disables console output. Otherwise console
# output is on when true, when NODE_ENV is not production, or when
# DOCKER_CONTAINER=true.
ENABLE_CONSOLE_LOGS=true
# LOG_EXCLUDE_HEALTH - true = health-check requests are not logged. Code default false.
LOG_EXCLUDE_HEALTH=true
# LOG_EXCLUDE_URLS - comma-separated URL prefixes not logged.
LOG_EXCLUDE_URLS=
# LOG_MAX_SAFESTR_LENGTH - truncate the JSON form of logged OBJECTS (meta and
# object messages) to N characters. Plain string messages are never truncated.
# Blank = no truncation (code default).
LOG_MAX_SAFESTR_LENGTH=
# LOG_CALLSITE - capture function/file/line in each entry. Code default true.
LOG_CALLSITE=true
# LOG_RETENTION_DAYS - delete logs/YYYY/MM/DD directories older than N days.
# 0 = disabled. Code default 90.
LOG_RETENTION_DAYS=90
# LOG_MAX_QUEUE_LENGTH - cap on queued-but-unwritten log entries. logger.* is
# fire-and-forget; on a disk stall an uncapped queue would grow until the
# process runs out of memory. On overflow the OLDEST entries are dropped and the
# loss is reported at CRIT once the disk catches up. Code default 10000.
LOG_MAX_QUEUE_LENGTH=10000

# System logs (Logs page "System" sub-tab)
# SYSTEM_LOG_MAX_READ_BYTES - bytes read from the tail of each level file per
# request. Code default 5242880 (5 MiB).
SYSTEM_LOG_MAX_READ_BYTES=5242880
# SYSTEM_LOG_STREAM_POLL_MS - poll interval for the live-tail stream, ms.
# Code default 5000.
SYSTEM_LOG_STREAM_POLL_MS=5000


# -----------------------------------------------------------------------------
# Password hashing
# -----------------------------------------------------------------------------
# PASSWORD_HASH_MODE - plain | bcrypt | argon2 | tripledes. Code default argon2.
#   plain     - no hashing. Development and unit tests ONLY; refused in production.
#   bcrypt    - for migrating existing bcrypt hashes.
#   argon2    - recommended for all new deployments.
#   tripledes - legacy reversible mode for migrating existing hashes; needs
#               PASSWORD_KEY. Not recommended.
PASSWORD_HASH_MODE=argon2
# PASSWORD_KEY - encryption key used only by tripledes mode.
PASSWORD_KEY=

# PASSWORD_ENCRYPTION_MODE - how T_ADMINS_DEV passwords are stored: bcrypt |
# argon2. Only REQUIRED when PASSWORD_HASH_MODE is weak (plain or tripledes);
# when PASSWORD_HASH_MODE is bcrypt or argon2, admin passwords follow it.
PASSWORD_ENCRYPTION_MODE=argon2

# BCRYPT_SALT_ROUNDS - bcrypt cost factor, 10-31. Code default 12.
# BCRYPT_SALT_ROUNDS=12


# -----------------------------------------------------------------------------
# Argon2 (PASSWORD_HASH_MODE=argon2 or PASSWORD_ENCRYPTION_MODE=argon2)
# -----------------------------------------------------------------------------
# ARGON2_PEPPER (required) - server-side secret mixed into every hash via
# HMAC-SHA256 before hashing, so a DB leak alone is not enough to crack hashes.
# Rotating it invalidates ALL existing hashes. Inject via a secrets manager in
# production.
ARGON2_PEPPER=replace_this_with_a_64_char_hex_string_generated_by_the_command_above

# ARGON2_MEMORY_COST - KiB per hash, 8192-4194304. Code default 19456 (OWASP
# minimum). 65536 is a good balance on a standard API server.
ARGON2_MEMORY_COST=19456
# ARGON2_TIME_COST - iterations, 1-999. Code default 2. Target 200-500 ms per hash.
ARGON2_TIME_COST=2
# ARGON2_PARALLELISM - threads, 1-64. Code default 1. Do not exceed CPU cores.
ARGON2_PARALLELISM=1
# ARGON2_HASH_LENGTH - raw hash bytes, 16-128. Code default 32. Temporary admin
# passwords must fit a 128-byte column, so at most 48 works for admin accounts.
ARGON2_HASH_LENGTH=32
# ARGON2_MAX_PASSWORD_BYTES - hard cap on password input size (DoS guard),
# 64-4096. Code default 1024.
ARGON2_MAX_PASSWORD_BYTES=1024


# -----------------------------------------------------------------------------
# Data integrity and at-rest encryption
# -----------------------------------------------------------------------------
# DATA_SIGNING_SECRET (required) - HMAC-SHA256 key for the tamper-evident
# SYSSIGNATURE on DB rows. Must differ from JWT_SECRET and ARGON2_PEPPER.
# Rotating it invalidates every stored SYSSIGNATURE. It also keys the log-line
# pseudonyms (src/utils/logRedaction.js): lines written before a rotation will
# not correlate with lines written after.
DATA_SIGNING_SECRET=replace_this_with_a_64_char_hex_string_generated_by_the_command_above

# CHANGELOG_ENCRYPTION_KEY (required) - AES-256-GCM key for data/changelog.enc.
# Must be exactly 64 hex characters (32 bytes); any other value falls back to
# DATA_SIGNING_SECRET (not recommended for production).
CHANGELOG_ENCRYPTION_KEY=replace_this_with_a_64_char_hex_string_generated_by_the_command_above


# -----------------------------------------------------------------------------
# Audit log and metrics
# -----------------------------------------------------------------------------
# AUDIT_LOG_ENABLED - false = no audit persistence; file logs continue.
# Code default true.
AUDIT_LOG_ENABLED=true
# AUDIT_LOG_EXCLUDE_HEALTH - exclude health checks from the audit log.
# Code default true.
AUDIT_LOG_EXCLUDE_HEALTH=true
# AUDIT_LOG_EXCLUDE_PATHS - comma-separated path prefixes not audited (prevents a
# self-referencing flood while the Logs page is open). Code default
# /api/v1/audit-logs.
AUDIT_LOG_EXCLUDE_PATHS=/api/v1/audit-logs
# AUDIT_LOG_STORAGE - db | file | auto. Code default auto.
#   db   - always Oracle (write failures propagate)
#   file - always the JSON-lines fallback under logs/Main/YYYY/MM/DD/
#   auto - Oracle first; on the first write failure switch permanently to the
#          file fallback for this process's lifetime
AUDIT_LOG_STORAGE=auto
# AUDIT_LOG_TABLE - table override. Blank = T_AUDIT_LOGS in production,
# T_AUDIT_LOGS_DEV elsewhere.
AUDIT_LOG_TABLE=

# METRICS_EXCLUDE_PATHS - comma-separated path prefixes excluded from per-route
# RED/latency metrics (the dashboards' own polling and long-lived streams would
# otherwise distort p95/p99). Code default /api/v1/audit-logs,/api/v1/metrics.
METRICS_EXCLUDE_PATHS=/api/v1/audit-logs,/api/v1/metrics


# -----------------------------------------------------------------------------
# Login lockout
# -----------------------------------------------------------------------------
# Per-user failed-login tracking (in memory, 24 h TTL; cluster-wide when
# clustered). An attempt that arrives while already locked is not counted.
# Values shown are the code defaults.
# LOGIN_MAX_ATTEMPTS        - failed attempts before the first lockout.
LOGIN_MAX_ATTEMPTS=3
# LOGIN_LOCKOUT_MODE        - fixed | incremental.
LOGIN_LOCKOUT_MODE=incremental
# LOGIN_LOCKOUT_DURATION_MS - base lockout duration, ms.
LOGIN_LOCKOUT_DURATION_MS=30000
# LOGIN_LOCKOUT_MULTIPLIER  - duration multiplier per cycle (incremental only).
LOGIN_LOCKOUT_MULTIPLIER=2
# LOGIN_MAX_LOCKOUT_CYCLES  - after this many cycles an administrator reset is
#                             required (HTTP 423).
LOGIN_MAX_LOCKOUT_CYCLES=3
# LOGIN_RETRY_DECREMENT     - fewer attempts allowed each successive cycle.
LOGIN_RETRY_DECREMENT=1


# -----------------------------------------------------------------------------
# Admin management
# -----------------------------------------------------------------------------
# ADMIN_DEFAULT_PASSWORD - RETIRED; leave UNSET. "Add" and "Reset Password" now
# generate a per-account temporary password (valid 72 hours, only for setting a
# new one) and email it to the account holder. While this is still set, an
# account whose stored hash matches it is forced to change it, and the value is
# refused as a new password.
# ADMIN_DEFAULT_PASSWORD=


# -----------------------------------------------------------------------------
# SMTP (outbound email - shared transporter)
# -----------------------------------------------------------------------------
# SMTP_HOST - code default localhost. Blank in this file = no relay configured.
SMTP_HOST=
# SMTP_PORT - code default 587.
SMTP_PORT=587
# SMTP_SECURE - true = implicit TLS (usually port 465). Code default false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM - envelope sender. Code default noreply@app.internal.
SMTP_FROM=noreply@app.internal
# SMTP_CA_FILE - file name of a PEM CA certificate inside certs/ for SMTP TLS
# verification, needed when the relay uses a private CA (e.g. internal-root.pem).
# Resolved from certs/ next to server.js (or next to the exe in pkg builds).
# Blank = system default CA bundle.
SMTP_CA_FILE=

# Pooling and pacing. Authenticated relays usually cap messages per minute; past
# the rate, sendMail() resolves LATER rather than failing. Values shown are the
# code defaults.
# EMAIL_POOL          - false = fresh connection per send and NO rate limiting.
EMAIL_POOL=true
# EMAIL_CONCURRENCY   - pooled SMTP connections.
EMAIL_CONCURRENCY=4
# EMAIL_MAX_MESSAGES  - messages per connection before it is recycled.
EMAIL_MAX_MESSAGES=100
# EMAIL_RATE_LIMIT    - messages allowed per rate window.
EMAIL_RATE_LIMIT=150
# EMAIL_RATE_DELTA_MS - rate window length, ms.
EMAIL_RATE_DELTA_MS=60000

# Email retries (EmailProtectionService). Values shown are the code defaults.
# EMAIL_RETRY_ATTEMPTS          - primary-tier attempts before falling back.
EMAIL_RETRY_ATTEMPTS=3
# EMAIL_FALLBACK_RETRY_ATTEMPTS - attempts for the fallback recipients.
EMAIL_FALLBACK_RETRY_ATTEMPTS=3
# EMAIL_RETRY_BASE_DELAY_MS     - backoff base, ms (ceiling fixed at 8 s).
EMAIL_RETRY_BASE_DELAY_MS=500


# -----------------------------------------------------------------------------
# Server email notifications (AlertNotifierService)
# -----------------------------------------------------------------------------
# Four ops-alert channels (server-critical, server-dependencies,
# server-red-metrics, server-system-notification) fed by the metrics alert rules
# plus a critical logger tap.

# ENABLE_SERVER_NOTIFICATIONS - master switch. Code default false: the notifier
# never starts, no SMTP traffic, no poll timer.
ENABLE_SERVER_NOTIFICATIONS=false

# SERVER_NOTIFY_TO - comma-separated recipients for ALL four channels, always
# combined (deduplicated) with the per-channel opt-ins on T_ADMINS_DEV
# (CAN_RECEIVE_SRV_CRIT/_DEPS/_RED/_SYS). Blank = DB opt-ins only.
SERVER_NOTIFY_TO=

# Values below are the code defaults.
# RECIPIENT_REFRESH_MIN - minutes the DB opt-in recipient list stays cached. On a
#   DB failure the previous list keeps being served.
RECIPIENT_REFRESH_MIN=5
# ALERT_POLL_INTERVAL_MS - metrics poll interval, ms.
ALERT_POLL_INTERVAL_MS=60000
# ALERT_EMAIL_COOLDOWN_MIN - minutes an alert must stay in the same state before
#   it is re-notified.
ALERT_EMAIL_COOLDOWN_MIN=30
# ALERT_NOTIFY_RECOVERY - send a "resolved" email when an alert clears.
ALERT_NOTIFY_RECOVERY=true
# ALERT_RECOVERY_CONFIRM_POLLS - consecutive clear polls before an alert counts
#   as recovered (escalation is immediate, de-escalation is damped).
ALERT_RECOVERY_CONFIRM_POLLS=3
# CRITICAL_DIGEST_WINDOW_MS - critical log events inside this window (ms) are
#   collapsed into ONE digest email.
CRITICAL_DIGEST_WINDOW_MS=30000
# CRITICAL_MAX_EMAILS_PER_HOUR - hard ceiling on critical-channel emails per
#   rolling hour; the next sent email reports how many were suppressed.
CRITICAL_MAX_EMAILS_PER_HOUR=10
# ALERT_LOG_RETENTION_DAYS - days alert-history rows are kept.
ALERT_LOG_RETENTION_DAYS=180
# ALERT_ACK_TTL_HOURS - hours an acknowledgement stays valid before the routine
#   re-notify resumes. Escalation past the acknowledged severity always clears
#   the ack (not configurable).
ALERT_ACK_TTL_HOURS=24
# SERVER_ALERT_LOG_TABLE / SERVER_ALERT_ACK_TABLE - table overrides. Blank =
#   T_SERVER_ALERT_LOG / T_SERVER_ALERT_ACK in production, *_DEV elsewhere.
SERVER_ALERT_LOG_TABLE=
SERVER_ALERT_ACK_TABLE=


# -----------------------------------------------------------------------------
# Resilience: DB retries, health probes, readiness stream
# -----------------------------------------------------------------------------
# Per-row DB write retries for transient failures (RetryPolicy defaults).
# Values shown are the code defaults.
# DB_ROW_RETRY_MAX       - attempts per row.
DB_ROW_RETRY_MAX=10
# DB_RETRY_BASE_DELAY_MS - exponential backoff base, ms.
DB_RETRY_BASE_DELAY_MS=200
# DB_RETRY_MAX_DELAY_MS  - backoff ceiling, ms.
DB_RETRY_MAX_DELAY_MS=5000

# HEALTH_PROBE_TIMEOUT_MS - upper bound for one /health/ready pool probe, ms.
HEALTH_PROBE_TIMEOUT_MS=2500
# Readiness push stream GET /api/v1/health/stream.
# HEALTH_STREAM_HEARTBEAT_MS - heartbeat interval, ms; keep well under the UI's
#   40 s stale limit.
HEALTH_STREAM_HEARTBEAT_MS=15000
# HEALTH_STREAM_EVAL_MS - readiness re-evaluation while a client is connected, ms.
HEALTH_STREAM_EVAL_MS=30000
# HEALTH_STREAM_MAX_PER_IP / HEALTH_STREAM_MAX_TOTAL - open streams per client IP
#   and per worker in total; extra requests get 429.
HEALTH_STREAM_MAX_PER_IP=50
HEALTH_STREAM_MAX_TOTAL=2000

# Not configurable here, listed for capacity planning:
#   - The scope-keyed SSE poller ticks every 5000 ms (code constant; a feature
#     may pass pollIntervalMs when constructing its own poller).
#   - IdempotencyMiddleware keeps replayable outcomes for 86400 s (24 h); the TTL
#     is a constructor option per route group.


# -----------------------------------------------------------------------------
# Request watchdog
# -----------------------------------------------------------------------------
# A request that makes NO progress (no DB call finished, no SMTP step, no socket
# byte moved, no explicit touch()) for this long is cut with a 504. SSE streams
# are never cut. Out-of-range values are clamped with a logger.warning.
# REQUEST_IDLE_TIMEOUT_MS      - ordinary requests, ms. Code default 120000,
#                                range 65000-600000.
# REQUEST_IDLE_TIMEOUT_LONG_MS - bulk / export / upload / backup routes (LONG_RULES
#                                in src/constants/requestWatchdog.js), ms.
#                                Code default 600000, range 65000-1800000.
# DB_CALL_PROGRESS_CAP_MS      - longest one in-flight DB call keeps its request
#                                alive, ms. Code default 1800000, range 65000-3600000.
# REQUEST_IDLE_TIMEOUT_MS=120000
# REQUEST_IDLE_TIMEOUT_LONG_MS=600000
# DB_CALL_PROGRESS_CAP_MS=1800000
#
# WATCHDOG_ALERT_BURST / WATCHDOG_ALERT_WINDOW_MS - when at least BURST cuts
# happen within WINDOW_MS on one process, ONE critical email is sent. BURST code
# default 3 (0 disables); WINDOW_MS code default 600000, range 1000-3600000.
# Invalid values fall back to the default.
# WATCHDOG_ALERT_BURST=3
# WATCHDOG_ALERT_WINDOW_MS=600000


# -----------------------------------------------------------------------------
# Graceful shutdown
# -----------------------------------------------------------------------------
# On a stop (service stop, SIGTERM/SIGINT/SIGBREAK) new requests are refused at
# once, live SSE streams are ended, and requests already in progress may finish,
# all bounded by the failsafe below. With ENABLE_SERVER_NOTIFICATIONS=true the
# server emails on shutdown start, on requests cut, on forced exit, and on the
# next start ("server started", at most one per 15 minutes; "restarted without
# a clean shutdown", never throttled). The cron leader keeps data/server-run.json
# for this (heartbeat every 30 s); never copy it between machines or delete it.
#
# SERVER_RUN_MARKER_PATH - leave UNSET. Tests only: an ABSOLUTE path that
# redirects the restart marker. Relative values are ignored with a warning and
# the override is refused when NODE_ENV=production.
# SERVER_RUN_MARKER_PATH=
#
# SHUTDOWN_FORCED_EXIT_MS - hard failsafe (exit 1), ms. Code default and MAXIMUM
# 1834000 (30 min request wait + 15 s drain + 13 s reserve + 6 s margin); may
# only be LOWERED, minimum 35000. Out-of-range values are clamped with a
# warning. Must stay below <stoptimeout> in
# deploy/winsw/catherine-backend-service.xml.
# SHUTDOWN_FORCED_EXIT_MS=1834000
#
# NOTIFY_DRAIN_MS - how long shutdown waits for tracked detached work (e.g.
# notification emails) to settle before the pools and SMTP transporter close,
# ms. Clamped to 0-15000; code default 15000, so it can be lowered but not
# raised. Invariant kept by the clamp constants in server.js:
#   35000 (failsafe min) - 13000 (teardown reserve) - 6000 (margin) >= 15000
NOTIFY_DRAIN_MS=15000


# -----------------------------------------------------------------------------
# Data purge and restore (SUPER_ADMIN only)
# -----------------------------------------------------------------------------
# Bulk group/table purge behind a mandatory pre-purge backup download; tables
# are registered in src/constants/purgeTables.js. Values shown are the code
# defaults.
# BACKUP_TOKEN_TTL_MINUTES - minutes a backup token stays valid. The token is
#   bound to the issuing admin and to a hash of the backed-up table scope.
BACKUP_TOKEN_TTL_MINUTES=30
# BACKUP_UPLOAD_MAX_MB - max .zip size accepted by the restore upload, MB.
BACKUP_UPLOAD_MAX_MB=100
# BACKUP_XLSX_ROW_CAP - row cap per sheet in the human-readable summary workbook
#   (never the restore source; all rows are always in data/*.jsonl).
BACKUP_XLSX_ROW_CAP=5000
# RESTORE_BATCH_SIZE - rows per executeMany chunk during a restore insert.
RESTORE_BATCH_SIZE=500
# PURGE_RATE_LIMIT_MAX - requests per 15-minute window on purge execute and
#   restore (a dedicated limiter, separate from RATE_LIMIT_MAX).
PURGE_RATE_LIMIT_MAX=5
# BACKUP_EMAIL_ENABLED - false = no notification email after a purge backup.
#   The email is notification-only (no attachment); the archive is downloaded
#   from the Backup tab. Scheduled and manual backups never email.
BACKUP_EMAIL_ENABLED=true


# -----------------------------------------------------------------------------
# Scheduled database backup
# -----------------------------------------------------------------------------
# Chain-aware FULL/INCREMENTAL archives written to disk on a schedule or via
# "Back Up Now". Values shown are the code defaults.
# DB_BACKUP_ENABLED - master switch for the backup scheduler.
DB_BACKUP_ENABLED=true
# DB_BACKUP_DIR - archive directory. Relative paths resolve against the
#   executable's directory in pkg builds, otherwise process.cwd(). Archives
#   contain password hashes and user identifiers: keep this OUTSIDE any served
#   path and outside dist/.
DB_BACKUP_DIR=db-backup
# DB_BACKUP_IDLE_TIMEOUT_MS - a backup with no progress for this long is
#   cancelled, ms. Also sets the cross-process lease stale window (this + 60 s).
#   Range 65000-3600000.
DB_BACKUP_IDLE_TIMEOUT_MS=600000
# DB_BACKUP_EVENT_DELAY_MS - delay after a scheduled backup event before the
#   backup fires, ms, so work tied to the event finishes first.
DB_BACKUP_EVENT_DELAY_MS=900000
# DB_BACKUP_LOCKOUT_WINDOW_MS - a manual backup or purge execute is refused with
#   409 when a scheduled backup is due within this window or running, ms.
#   Operator ergonomics only; the backup run lock is what keeps the chain
#   consistent. Scheduled and purge-internal backups are exempt.
DB_BACKUP_LOCKOUT_WINDOW_MS=60000
# DB_BACKUP_CATCHUP_ON_BOOT - catch up a missed scheduled backup on the next boot.
DB_BACKUP_CATCHUP_ON_BOOT=true
# DB_BACKUP_CATCHUP_WINDOW_HOURS - how far back the catch-up sweep looks, hours.
DB_BACKUP_CATCHUP_WINDOW_HOURS=72
# DB_BACKUP_FULL_EVERY - force a FULL base archive every N runs.
DB_BACKUP_FULL_EVERY=6
# DB_BACKUP_RETENTION_DAYS - a whole chain is pruned only once its NEWEST member
#   is older than this many days.
DB_BACKUP_RETENTION_DAYS=180


# -----------------------------------------------------------------------------
# Money (optional multi-currency capability)
# -----------------------------------------------------------------------------
# None of these are needed to boot. With MONEY_BASE_CURRENCY unset the money
# boot guard is a no-op. Amounts are stored in the base currency at a fixed
# scale of 4 (NUMBER(19,4)); conversion happens at view/export time via
# FxRateService. See Backend/CLAUDE.md, section Money.
#
# MONEY_BASE_CURRENCY - registered ISO 4217 code (src/constants/currencies.js)
#   every stored amount is denominated in, e.g. USD or EUR.
# MONEY_BASE_CURRENCY=
#
# MONEY_FX_TABLE - FX-rate table read by FxRateService. Unset (outside demo mode)
#   = the FX service returns 503. Reference DDL is in Backend/sql/README.md.
# MONEY_FX_TABLE=
#
# MONEY_LEDGER_TABLES - comma-separated ledger tables. Declaring at least one
#   arms the base-currency change guard below.
# MONEY_LEDGER_TABLES=
#
# Base-currency change guard: once ledger tables exist the boot guard refuses to
# start when MONEY_BASE_CURRENCY differs from MONEY_BASE_CURRENCY_PREVIOUS,
# unless MONEY_BASE_CURRENCY_MIGRATION=true (a deliberate new epoch; past
# postings are never restated).
# MONEY_BASE_CURRENCY_PREVIOUS=
# MONEY_BASE_CURRENCY_MIGRATION=false


# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# DOCKER_CONTAINER - true when running in a container (forces console logging on).
DOCKER_CONTAINER=false

# Windows service (WinSW): the compiled exe reads THIS file from the folder next
# to the exe (dist\.env) and writes logs\ and data\ there. When installed via
# deploy\winsw\install-service.ps1 the service account needs read/write access
# to that folder, and read access to the certs\ PFX (USE_HTTPS=true) and the
# ORACLE_INSTANT_CLIENT path.
