{
    // Type-check for test/. Same compiler options as tsconfig.json plus Vitest's
    // injected globals (vitest.config.mts: globals: true). Run: bun run typecheck
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["bun", "vitest/globals"],
        // Test doubles and callbacks are written untyped (vi.fn mocks, fixture rows).
        // Everything else stays strict: wrong arity, unknown members and bad calls
        // into src/ are still errors.
        "noImplicitAny": false
    },
    "include": ["test/**/*.ts", "src/types/**/*.d.ts"],
    // The oracle-mongo-wrapper harness is a hand-run mocha+chai suite against a real
    // Oracle, with its own package.json so mocha/chai stay out of this dependency tree
    // (see its header); its types live there, not here.
    "exclude": ["test/oracle-mongo-wrapper/**"]
}
