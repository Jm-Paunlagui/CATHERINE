{
    "name": "catherine-backend",
    "version": "1.0.0-dev.51",
    "description": "CATHERINE Template — Production-grade Express 5 + OracleDB backend with JWT auth, RBAC, audit logging, exact-decimal money, and observability.",
    "homepage": "https://github.com/Jm-Paunlagui/NodeExpress-Template#readme",
    "bugs": {
        "url": "https://github.com/Jm-Paunlagui/NodeExpress-Template/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jm-Paunlagui/NodeExpress-Template.git"
    },
    "keywords": [
        "express",
        "oracle",
        "oracledb",
        "template",
        "jwt",
        "rbac",
        "audit-log",
        "backend"
    ],
    "license": "Apache-2.0",
    "author": "Jm-Paunlagui",
    "type": "commonjs",
    "main": "server.js",
    "engines": {
        "bun": ">=1.4.5"
    },
    "packageManager": "bun@1.4.5",
    "scripts": {
        "prepare": "bun scripts/install-git-hooks.js",
        "audit:changelog-release": "bun scripts/verify-changelog-release.js",
        "start": "bun server.js",
        "lint": "bun --bun eslint .",
        "lint:fix": "bun --bun eslint . --fix",
        "db:seed:template": "bun scripts/seed-template.js",
        "changelog:dump": "bun scripts/dump-changelog.js",
        "changelog:seed": "bun scripts/seed-changelog.js",
        "build": "bun scripts/build.js",
        "build:host": "bun scripts/build.js --target=host",
        "test": "bun --bun vitest run",
        "test:watch": "bun --bun vitest",
        "test:coverage": "bun --bun vitest run --coverage",
        "test:ui": "bun --bun vitest --ui",
        "test:unit": "bun --bun vitest run test/server/unit test/unit",
        "test:integration": "bun --bun vitest run test/server/integration",
        "test:security": "bun --bun vitest run test/server/security",
        "test:performance": "bun --bun vitest run test/server/performance",
        "test:reliability": "bun --bun vitest run test/server/reliability",
        "test:resilience": "bun --bun vitest run test/server/reliability",
        "test:chaos": "bun --bun vitest run chaos",
        "test:purge": "bun --bun vitest run purge dataPurge restore backup adminRevoke",
        "test:metrics": "bun --bun vitest run test/server/unit/middleware/metricsStore.test.js test/server/unit/middleware/metricsStore.memory.test.js test/server/unit/middleware/metricsRouteLabel.test.js test/server/integration/metrics.test.js test/server/integration/metrics/metrics.test.js",
        "test:money": "bun --bun vitest run test/unit/money.test.js test/unit/moneyFetchTypeHandler.test.js test/unit/signedFields.test.js test/unit/constants/currencies.test.js test/unit/FxRateService.test.js test/unit/bootGuardMoney.test.js test/unit/convertTypesFence.test.js"
    },
    "dependencies": {
        "archiver": "^6.0.2",
        "argon2": "^0.44.0",
        "axios": "^1.15.3",
        "bcryptjs": "^3.0.3",
        "blob-stream": "^0.1.3",
        "body-parser": "2.4.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "csrf-csrf": "^4.0.3",
        "csv-parser": "^3.2.0",
        "dotenv": "^17.4.1",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "express-validator": "^7.3.2",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "jszip": "^3.10.1",
        "multer": "2.5.0",
        "nanoid": "^5.1.7",
        "node-cache": "^5.1.2",
        "node-cron": "^4.2.1",
        "nodemailer": "10.2.1",
        "oracledb": "^6.10.0",
        "pdfkit": "^0.18.0",
        "uuid": "^11.1.1"
    },
    "bin": {
        "catherine_backend": "./server.js"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@vitest/coverage-istanbul": "^4.1.12",
        "@vitest/coverage-v8": "^4.1.12",
        "@vitest/ui": "^4.1.12",
        "eslint": "^9.39.5",
        "globals": "^17.12.0",
        "supertest": "^7.2.2",
        "vitest": "^4.1.12"
    },
    "overrides": {
        "uuid": "^11.1.1"
    }
}
