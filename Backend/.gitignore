# Ignore node_modules
node_modules/

# Ignore logs
logs/
*.log
npm-debug.log*

# Ignore environment variables
.env
.env.test
.env.production
# Catch every .env variant (e.g. .env.migration, leaked 2026-08-14).
# Keep the committed template.
.env.*
!.env.example

# Ignore build output
dist/
build/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/
*.iml

.env
certs/
# WinSW service wrapper binary — drop into deploy/winsw/, never commit
deploy/winsw/WinSW-x64.exe

# Scheduled DB Backup archives — plaintext credential material. Default
# location; DB_BACKUP_DIR can point elsewhere.
db-backup/

# Re-include the email-template folder that shares the unanchored db-backup/ name.
!src/utils/email-templates/db-backup/
!src/utils/email-templates/db-backup/**

# Generated coverage artifacts — never commit
coverage/

# Fleet project profile — machine-specific, generated by /fleet-init.
project-profile.md

# Ad-hoc run scratch at the repo root only; test-evidence/*.txt stays tracked.
/*.txt
/cov-*/
/coverage-*/
/cov_*/
/latest-coverage.md

# Audit run output. scripts/audit-*.js dump real production rows; machine-local
# evidence only, never committed.
audit-*.json
audit-*.txt

# Dev-docs freshness snapshot, regenerated every build.
src/generated/

# Production log archives pulled for analysis — contain user identifiers.
prod-logs/

# Vitest blob reports.
.vitest-reports/

# Local scratch, never committed.
/.local-artifacts/

# Script run output. Regenerated per run, machine-local.
scripts/out/

# Office lock files (Excel/Word owner files left while a workbook is open).
~$*

# Runtime restart-detection marker - machine state, never commit or copy
data/server-run.json
data/server-run.json.*.tmp
