<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Let IIS return the app's own 404/500 bodies instead of swapping in its
         default error pages. Without this, a genuinely missing hashed asset is
         reported as an IIS error page rather than a clean 404. -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <!-- CORS headers are the API's responsibility, not the static host's.
             They were removed from here on purpose. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=()" />

        <!-- HSTS. IIS is the ONLY layer that can set headers on the SPA's own
             HTML response — the API is on a different port and can never reach
             this document. Browsers ignore this header on a plain-HTTP response,
             so it is inert for a local HTTP test build and only takes effect on
             the real HTTPS deployment.
             No `preload` directive on purpose: preload submission is effectively
             irreversible and is a decision for whoever owns the domain. -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />

    <!-- ────────────────────────────────────────────────────────────────────
         Content-Security-Policy — ACTIVE, and generated at BUILD time.

         The `connect-src` origin below is a placeholder token (spelled out only
         in the header value, never in prose — the build guard greps for it and
         a copy in a comment would let a deleted CSP header pass). vite.config.js's
         `csp-web-config` plugin rewrites this file in `dist/` on every
         production build, substituting the API origin derived from
         VITE_API_BASE_URL (`new URL(apiBase).origin`).

         Deriving it instead of hand-writing a hostname means the CSP can never
         drift from the origin the app actually calls — the two now come from a
         single source. The build FAILS if the placeholder is still present
         afterwards, so a silently-unsubstituted CSP (which would block every
         API call, the CSRF bootstrap and all SSE streams) cannot ship.

         Do NOT hand-edit the value in `dist/` — edit this file, or the plugin.

         Each directive below was derived from the actual built output:
           script-src 'self'          — the production build emits NO inline
                                        <script>; every chunk is an external
                                        module file. 'unsafe-inline' is NOT
                                        needed and must not be added back.
           style-src  + 'unsafe-inline' — REQUIRED. React `style={{…}}` props
                                        and any injected <style> blocks are
                                        inline styles.
           img-src    + data: blob:   — data: URIs and blob: object URLs (e.g.
                                        client-side file exports).
           font-src 'self'            — self-hosted .ttf/.woff2 under /assets.
           connect-src                — XHR, fetch AND EventSource (SSE streams)
                                        all target the API origin, which is a
                                        DIFFERENT PORT and therefore a different
                                        origin from 'self'.
           frame-ancestors 'none'     — clickjacking (CWE-1021); pairs with the
                                        X-Frame-Options header above.

         NOTE: this header lives in the SAME <httpProtocol> block as the ones
         above on purpose. IIS treats a second <httpProtocol> element inside one
         <system.webServer> as a duplicate section definition and fails the whole
         site with 500.19 — every request, including /. Never split them.
    ────────────────────────────────────────────────────────────────────── -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' __CSP_CONNECT_SRC__; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- remove-then-add: IIS throws 500.19 on a duplicate mimeMap entry when
           the extension is already present in applicationHost.config. -->
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <rewrite>
      <rules>
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- Never rewrite /assets/*. A stale or missing hashed chunk must
                 return a real 404, not index.html with a text/html content-type
                 (the browser blocks the module and the app renders blank). -->
            <add input="{REQUEST_URI}" pattern="^/assets/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!-- index.html must never be cached: it is the only file whose name is stable
       while the hashed asset names inside it change on every build. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Hashed assets are content-addressed and safe to cache forever. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
