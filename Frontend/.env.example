# ── API ─────────────────────────────────────────────────────────────────────
# Base URL for all httpClient / CsrfMiddleware requests and SSE streams
# (trailing slash required). Baked in at BUILD time — there is no runtime config.
# Local dev: the backend listens on PORT=2108 over plain http (Backend/.env.example;
# https only when USE_HTTPS=true with a PFX in Backend/certs/). Use your LAN IP
# instead of localhost to test from another device, and list this app's origin
# (http://localhost:5173) in the backend's CORS_ORIGINS.
# Production: https://<SERVER>:<PORT>/api/v1/ — the build FAILS when this is unset
# or plain http:// (see VITE_ALLOW_INSECURE_API below).
VITE_API_BASE_URL=http://localhost:2108/api/v1/

# VITE_ALLOW_INSECURE_API — escape hatch for a deliberate plain-HTTP PRODUCTION
# build. The value is baked in at build time (there is no runtime config), so a
# production build guard (vite.config.js) HARD-FAILS if VITE_API_BASE_URL is
# unset or plain http://, because an HTTPS-served page cannot call an HTTP API
# (the browser blocks it as mixed content). Set this to "true" ONLY when you
# intentionally serve BOTH the app and the API over plain HTTP on a trusted
# network for testing. localhost / 127.0.0.1 URLs are exempt and never need it.
# Leave unset for any real deployment — use https:// instead. Default: unset.
# VITE_ALLOW_INSECURE_API=false

# ── Application identity ─────────────────────────────────────────────────────
# Display name used in the navbar, sidebar header, sign-in page and document titles.
# Unset: the navbar/sidebar show no name; sign-in and tab titles fall back to "App".
VITE_APP_NAME=CATHERINE

# ── Version & release stage ──────────────────────────────────────────────────
# Version string shown by the version badge (navbar/sidebar/version history).
# Leave unset to fall back to the version in package.json (injected at build time).
# A semver pre-release tag (e.g. 1.23.4-beta.2) auto-selects the stage below.
# Default: unset (package.json version).
# VITE_APP_VERSION=1.0.0
# Release stage shown next to the version. One of: dev | alpha | beta | rc | stable.
# Precedence: this var > pre-release tag on the version > (production ? stable : dev).
#   dev    → Developer Preview   alpha → Alpha          beta → Beta
#   rc     → Release Candidate   stable → Stable (production)
# Default: unset (derived as above).
# VITE_APP_STAGE=dev

# ── Layout ───────────────────────────────────────────────────────────────────
# Controls the default navigation chrome — "sidebar" or "top"
VITE_LAYOUT_MODE=sidebar

# ── Theme ────────────────────────────────────────────────────────────────────
# Default colour scheme on first load — "light", "dark", or "system"
VITE_THEME=system

# ── Environment flag ─────────────────────────────────────────────────────────
# "development": the 440 / invalid-token error pages skip the automatic sign-out
# call, so they can be previewed locally without ending your session.
# "production": the version badge treats the build as production (Stable stage),
# same as a `vite build`. Leave unset (or "production") for real deployments.
VITE_ENV=development

# ── Session / warning modal ──────────────────────────────────────────────────
# Total session lifetime in milliseconds (must match JWT_EXPIRES_IN on the backend,
# default 30m). Default: 1 800 000 ms = 30 minutes
VITE_SESSION_TIMEOUT_MS=1800000
# How many seconds before expiry the warning modal appears and countdown starts
# Default: 30 s
VITE_SESSION_WARNING_SECS=30

# ── Navigation redirects ─────────────────────────────────────────────────────
# Post-login landing pages are role-based and defined in code:
# src/features/auth/roleRedirect.js (ROLE_LANDING_PATHS — every role → /dashboard).
